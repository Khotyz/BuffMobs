{
  "schemaVersion": 1,
  "id": "buffmobs",
  "version": "${version}",
  "name": "BuffMobs",
  "description": "Makes hostile and neutral mobs stronger, faster, and more challenging with progressive difficulty scaling.",
  "authors": ["Khotyz"],
  "contact": {
    "homepage": "https://github.com/Khotyz/BuffMobs",
    "sources": "https://github.com/Khotyz/BuffMobs",
    "issues": "https://github.com/Khotyz/BuffMobs/issues"
  },
  "license": "MIT",
  "icon": "assets/buffmobs/buffmobs.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.khotyz.buffmobs.BuffMobsMod"],
    "client": ["com.khotyz.buffmobs.BuffMobsClient"],
    "modmenu": ["com.khotyz.buffmobs.config.ModMenuIntegration"]
  },
  "mixins": ["buffmobs.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "fabric-key-binding-api-v1": "*",
    "fabric-lifecycle-events-v1": "*",
    "minecraft": "~1.21.11"
  },
  "suggests": {
    "modmenu": ">=17.0.0"
  },
  "accessWidener": "buffmobs.accesswidener"
}